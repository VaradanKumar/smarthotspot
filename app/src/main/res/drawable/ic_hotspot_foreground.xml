<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:translateX="54"
        android:translateY="54">

        <!-- The Core Phone Unit -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M0,-6.5 A6.5,6.5 0 1,1 0,6.5 A6.5,6.5 0 1,1 0,-6.5" />

        <!-- Outer Nexus Arcs -->
        <!-- Primary Active Link -->
        <path
            android:pathData="M-18,-18 A25.4,25.4 0 0,1 18,18"
            android:strokeWidth="5"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:endX="18"
                    android:endY="18"
                    android:startX="-18"
                    android:startY="-18"
                    android:type="linear">
                    <item android:color="#CCFF00" android:offset="0.0" />
                    <item android:color="#0066FF" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Secondary Dynamic Beam -->
        <path
            android:pathData="M12,-22 A25.4,25.4 0 0,0 -22,12"
            android:strokeWidth="5"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:endX="-22"
                    android:endY="12"
                    android:startX="12"
                    android:startY="-22"
                    android:type="linear">
                    <item android:color="#0066FF" android:offset="0.0" />
                    <item android:color="#CCFF00" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

    </group>
</vector>
